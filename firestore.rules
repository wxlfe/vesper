rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function membershipPath(groupId, userId) {
      return /databases/$(database)/documents/group_members/$(groupId + '_' + userId);
    }

    function requestSharePath(requestId, groupId) {
      return /databases/$(database)/documents/request_shares/$(requestId + '_' + groupId);
    }

    function requestKeyGrantPath(requestId, userId) {
      return /databases/$(database)/documents/request_key_grants/$(requestId + '_' + userId);
    }

    function isActiveMember(groupId) {
      return signedIn()
        && exists(membershipPath(groupId, request.auth.uid))
        && get(membershipPath(groupId, request.auth.uid)).data.status == 'active';
    }

    function isLeader(groupId) {
      return isActiveMember(groupId)
        && get(membershipPath(groupId, request.auth.uid)).data.role == 'leader';
    }

    function isActiveMemberUser(groupId, userId) {
      return exists(membershipPath(groupId, userId))
        && get(membershipPath(groupId, userId)).data.status == 'active';
    }

    function hasRequestGrant(requestId) {
      return signedIn() && exists(requestKeyGrantPath(requestId, request.auth.uid));
    }

    function validEncryptedPayload(data) {
      return data.ciphertext is string
        && data.ciphertext.size() > 0
        && data.ciphertext.size() < 900000
        && data.nonce is string
        && data.nonce.size() > 0
        && data.nonce.size() < 256
        && data.keyVersion is int
        && data.payloadVersion is int
        && data.algorithm is string;
    }

    function validCanonicalRequest(data) {
      return data.keys().hasOnly(['createdBy', 'createdAt', 'updatedAt', 'status', 'anonymous', 'keyVersion', 'payloadVersion', 'algorithm', 'ciphertext', 'nonce', 'metadata'])
        && data.createdBy is string
        && data.status in ['active', 'answered', 'resolved', 'archived', 'deleted']
        && data.anonymous is bool
        && data.metadata is map
        && data.metadata.keys().hasOnly(['hasFollowup', 'hasReminder', 'followUpAt', 'updateCount'])
        && data.metadata.hasFollowup is bool
        && data.metadata.hasReminder is bool
        && data.metadata.updateCount is int
        && validEncryptedPayload(data);
    }

    function validRequestShare(data) {
      return data.keys().hasOnly(['requestId', 'groupId', 'sharedBy', 'sharedAt', 'status', 'removedAt', 'removedBy'])
        && data.requestId is string
        && data.groupId is string
        && data.sharedBy is string
        && data.status in ['active', 'removed', 'deleted'];
    }

    function validRequestKeyGrant(data) {
      return data.keys().hasOnly(['requestId', 'userId', 'grantedBy', 'grantedViaGroupId', 'createdAt', 'encryptedGroupKey', 'nonce', 'ephemeralPublicKey', 'algorithm'])
        && data.requestId is string
        && data.userId is string
        && data.grantedBy is string
        && (data.grantedViaGroupId == null || data.grantedViaGroupId is string)
        && data.encryptedGroupKey is string
        && data.encryptedGroupKey.size() > 0
        && data.encryptedGroupKey.size() < 4096
        && data.nonce is string
        && data.ephemeralPublicKey is string
        && data.algorithm == 'x25519-xchacha20-poly1305';
    }

    function validGroup(data) {
      return data.keys().hasOnly(['name', 'description', 'createdBy', 'createdAt', 'updatedAt', 'memberCount', 'activeKeyVersion', 'settings'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 240
        && data.createdBy is string
        && data.memberCount is int
        && data.activeKeyVersion is int
        && data.settings is map
        && data.settings.keys().hasOnly(['allowAnonymous', 'allowMemberInvites'])
        && data.settings.allowAnonymous is bool
        && data.settings.allowMemberInvites is bool;
    }

    function validMembership(data) {
      return data.keys().hasOnly(['groupId', 'userId', 'role', 'joinedAt', 'invitedBy', 'status'])
        && data.groupId is string
        && data.userId is string
        && data.role in ['leader', 'member']
        && data.status in ['pending', 'active', 'removed', 'blocked'];
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'publicKey', 'publicKeyAlgorithm', 'createdAt', 'lastActiveAt', 'notificationPreferences'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.publicKey is string
        && request.resource.data.publicKey.size() > 0
        && request.resource.data.publicKey.size() < 2048
        && request.resource.data.publicKeyAlgorithm == 'x25519';
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isActiveMember(groupId);
      allow create: if signedIn()
        && validGroup(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isLeader(groupId) && validGroup(request.resource.data);
      allow delete: if false;
    }

    match /group_members/{membershipId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isActiveMember(resource.data.groupId));
      allow create: if signedIn()
        && validMembership(request.resource.data)
        && (
          (request.resource.data.userId == request.auth.uid
            && request.resource.data.role == 'leader'
            && request.resource.data.status == 'active'
            && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid)
          || isLeader(request.resource.data.groupId)
        );
      allow update: if isLeader(resource.data.groupId)
        && validMembership(request.resource.data)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    match /group_keys/{groupKeyId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.groupId is string
        && request.resource.data.userId is string
        && request.resource.data.keyVersion is int
        && request.resource.data.encryptedGroupKey is string
        && request.resource.data.nonce is string
        && request.resource.data.ephemeralPublicKey is string
        && request.resource.data.algorithm == 'x25519-xchacha20-poly1305'
        && request.resource.data.status == 'active'
        && (request.resource.data.userId == request.auth.uid || isLeader(request.resource.data.groupId));
      allow update, delete: if false;
    }

    match /invite_codes/{inviteCodeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && isActiveMember(request.resource.data.groupId)
        && request.resource.data.keys().hasOnly(['groupId', 'codeHash', 'createdBy', 'createdAt', 'expiresAt', 'status', 'useCount', 'maxUses'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.codeHash is string
        && request.resource.data.codeHash.size() > 0
        && request.resource.data.codeHash.size() < 128
        && request.resource.data.status == 'active';
      allow update: if isLeader(resource.data.groupId);
      allow delete: if false;
    }

    match /join_requests/{joinRequestId} {
      allow read: if signedIn() && (resource.data.requestedBy == request.auth.uid || isLeader(resource.data.groupId));
      allow create: if signedIn()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.groupId is string
        && request.resource.data.inviteCodeId is string;
      allow update: if isLeader(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.status in ['approved', 'rejected', 'cancelled'];
      allow delete: if false;
    }

    match /group_settings_changes/{changeId} {
      allow read: if isLeader(resource.data.groupId);
      allow create: if isLeader(request.resource.data.groupId)
        && request.resource.data.proposedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['add_leader', 'remove_member']
        && request.resource.data.keys().hasOnly(['groupId', 'type', 'proposedBy', 'targetUserId', 'proposedSettings', 'status', 'createdAt', 'expiresAt', 'resolvedAt', 'approvals', 'disputes']);
      allow update: if isLeader(resource.data.groupId);
      allow delete: if false;
    }

    match /prayer_requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.createdBy == request.auth.uid || hasRequestGrant(requestId));
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && validCanonicalRequest(request.resource.data);
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.status in ['active', 'answered', 'resolved', 'archived', 'deleted']
        && validCanonicalRequest(request.resource.data);
      allow delete: if false;
    }

    match /request_shares/{shareId} {
      allow read: if isActiveMember(resource.data.groupId);
      allow create: if signedIn()
        && validRequestShare(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.sharedBy == request.auth.uid
        && isActiveMember(request.resource.data.groupId)
        && existsAfter(/databases/$(database)/documents/prayer_requests/$(request.resource.data.requestId))
        && getAfter(/databases/$(database)/documents/prayer_requests/$(request.resource.data.requestId)).data.createdBy == request.auth.uid;
      allow update: if isLeader(resource.data.groupId)
        && validRequestShare(request.resource.data)
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.sharedBy == resource.data.sharedBy
        && request.resource.data.status in ['removed', 'deleted'];
      allow delete: if false;
    }

    match /request_key_grants/{grantId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && validRequestKeyGrant(request.resource.data)
        && request.resource.data.grantedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/prayer_requests/$(request.resource.data.requestId))
        && (
          (
            request.resource.data.userId == request.auth.uid
            && request.resource.data.grantedViaGroupId == null
            && getAfter(/databases/$(database)/documents/prayer_requests/$(request.resource.data.requestId)).data.createdBy == request.auth.uid
          )
          ||
          (
            getAfter(/databases/$(database)/documents/prayer_requests/$(request.resource.data.requestId)).data.createdBy == request.auth.uid
            && request.resource.data.grantedViaGroupId is string
            && isActiveMember(request.resource.data.grantedViaGroupId)
            && isActiveMemberUser(request.resource.data.grantedViaGroupId, request.resource.data.userId)
            && existsAfter(requestSharePath(request.resource.data.requestId, request.resource.data.grantedViaGroupId))
            && getAfter(requestSharePath(request.resource.data.requestId, request.resource.data.grantedViaGroupId)).data.status == 'active'
          )
          ||
          (
            request.resource.data.grantedViaGroupId is string
            && isLeader(request.resource.data.grantedViaGroupId)
            && isActiveMemberUser(request.resource.data.grantedViaGroupId, request.resource.data.userId)
            && existsAfter(requestSharePath(request.resource.data.requestId, request.resource.data.grantedViaGroupId))
            && getAfter(requestSharePath(request.resource.data.requestId, request.resource.data.grantedViaGroupId)).data.status == 'active'
            && exists(requestKeyGrantPath(request.resource.data.requestId, request.auth.uid))
          )
        );
      allow update, delete: if false;
    }

    match /prayer_actions/{actionId} {
      allow read: if hasRequestGrant(resource.data.requestId);
      allow create: if hasRequestGrant(request.resource.data.requestId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type == 'prayed'
        && request.resource.data.keys().hasOnly(['requestId', 'userId', 'type', 'createdAt'])
        && request.resource.data.requestId is string;
      allow update, delete: if false;
    }

    match /request_reports/{reportId} {
      allow read: if isLeader(resource.data.groupId);
      allow create: if isActiveMember(request.resource.data.groupId)
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['groupId', 'requestId', 'reportedBy', 'createdAt', 'status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.groupId is string
        && request.resource.data.requestId is string
        && exists(/databases/$(database)/documents/prayer_requests/$(request.resource.data.requestId))
        && exists(requestSharePath(request.resource.data.requestId, request.resource.data.groupId))
        && get(requestSharePath(request.resource.data.requestId, request.resource.data.groupId)).data.status == 'active'
        && request.resource.data.reportedBy is string
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null;
      allow update: if isLeader(resource.data.groupId)
        && request.resource.data.keys().hasOnly(['groupId', 'requestId', 'reportedBy', 'createdAt', 'status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.reportedBy == resource.data.reportedBy
        && request.resource.data.status in ['dismissed', 'removed'];
      allow delete: if false;
    }

    match /prayer_updates/{updateId} {
      allow read: if isActiveMember(resource.data.groupId);
      allow create: if isActiveMember(request.resource.data.groupId) && validEncryptedPayload(request.resource.data);
      allow update, delete: if false;
    }

    match /prayer_sessions/{sessionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.sortOrder is int
        && request.resource.data.reminder is map
        && validEncryptedPayload(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status in ['active', 'archived', 'deleted']
        && request.resource.data.sortOrder is int
        && request.resource.data.reminder is map
        && validEncryptedPayload(request.resource.data);
      allow delete: if false;
    }

    match /routine_sections/{sectionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sessionId is string
        && request.resource.data.sortOrder is int
        && request.resource.data.type in ['custom_text', 'request_feed', 'heading', 'silence', 'reading_placeholder']
        && request.resource.data.status == 'active'
        && validEncryptedPayload(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.sortOrder is int
        && request.resource.data.type in ['custom_text', 'request_feed', 'heading', 'silence', 'reading_placeholder']
        && request.resource.data.status in ['active', 'deleted']
        && validEncryptedPayload(request.resource.data);
      allow delete: if false;
    }

    match /personal_prayers/{personalPrayerId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active'
        && validEncryptedPayload(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status in ['active', 'archived', 'deleted']
        && validEncryptedPayload(request.resource.data);
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
    }

    match /devices/{deviceId} {
      allow read, create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /audit_events/{eventId} {
      allow read: if isLeader(resource.data.groupId);
      allow write: if false;
    }
  }
}
